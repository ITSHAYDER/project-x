# showcase = demo for investors, psychologists, clinics (synthetic data). product = the real deal (needs Supabase + real auth).
APP_MODE=product
# Product mode only: the secret you give clinicians so only they can register as clinicians. Unset = clinician sign-up closed.
CLINICIAN_SIGNUP_CODE=TEST
# Product mode only: where the MVP stores data (a JSON file). Needs a server with a persistent disk. Default .data/db.json
PX_DATA_FILE=.data/db.json
# Optional. The product works fully without AI. AI only re-words statements that were computed
# deterministically, and every AI output is verified before it is shown.
GEMINI_API_KEY=
# Model names are retired over time. Run `npm run ai:diagnose` to list models your key can use.
GEMINI_MODEL=gemini-2.5-flash
# Only honoured in product mode. Never set to true until docs/GO_LIVE_CHECKLIST.md is satisfied.
ALLOW_REAL_PATIENT_DATA=false

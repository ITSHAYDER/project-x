# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local.

# From Supabase: Project Settings -> API.
# The anon key is safe to expose in the browser IF RLS is enabled on
# every table (it is, as of migration 0001) -- it has no power on its
# own without RLS policies granting access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Used only to display the full invite link on the
# psychiatrist dashboard. Leave blank for local dev -- it falls back to
# http://localhost:3000. Set this to your real Vercel URL once deployed,
# e.g. https://project-x-yourname.vercel.app
NEXT_PUBLIC_SITE_URL=

# Free key from https://aistudio.google.com/apikey (Google account
# required, no payment method needed for the free tier). Required only
# for the AI summary feature -- everything else works without it.
GEMINI_API_KEY=
